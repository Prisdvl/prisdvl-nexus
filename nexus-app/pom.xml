<?xml version="1.0" encoding="UTF-8"?>
<!--
  nexus-app — 可执行应用（模块化单体）
  职责：Web 层（auth / chat / knowledge / rag / agent / tool / workflow / evaluation / observability / prompt）
        + 全局配置 + 事务边界 + 安全。
  这是唯一声明 spring-boot-maven-plugin 的模块（可执行 jar）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lky.nexus</groupId>
        <artifactId>prisdvl-nexus</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>nexus-app</artifactId>
    <name>nexus-app</name>
    <description>Prisdvl-Nexus 应用：模块化单体 Web 层</description>

    <dependencies>
        <dependency>
            <groupId>com.lky.nexus</groupId>
            <artifactId>nexus-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lky.nexus</groupId>
            <artifactId>nexus-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.lky.nexus</groupId>
            <artifactId>nexus-knowledge</artifactId>
        </dependency>

        <!-- Web MVC：Boot 4 起 spring-boot-starter-web 已废弃，使用 spring-boot-starter-webmvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 可观测（Step 0.7 起用 /actuator/health 做验收） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Redis：限流 / 每日配额 / 令牌版本的存储（Phase 5.6，见 docs/decisions.md ADR-020）。
             之前 Redis 只存在于 deploy/docker-compose.yml 和注释里，没有任何 Java 依赖。
             两个必须知道的点：
             1) Lettuce 是懒连接（eagerInitialization=false），所以 standalone / test
                这两个"零外部基础设施"的 profile 照样能启动 —— 它们走内存实现
                （nexus.security.redis-enabled=false）；
             2) 该 starter 会带来 Redis 健康指示器，它会真去连一次。那两个 profile 必须
                显式 management.health.redis.enabled=false，否则 /actuator/health 变 DOWN。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 消息队列：导入任务异步化（Step 2.7）。
             只有"投递/消费"这两个适配器在 nexus-app，领域层通过 ImportTaskPublisher
             接口与具体中间件解耦（依赖倒置），因此 standalone profile 能换成同步实现。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- ES 官方 Java Client（ADR-006：BM25 用原生客户端，不套 Spring Data ES）。
             理由：本项目要控制的东西很具体——IK 分析器的索引/查询分词器分别设置、
             多字段权重、别名原子切换、过滤条件与打分。这些在原生 API 上是一等公民，
             套一层抽象后反而要绕过它。 -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
            <version>${elasticsearch-java.version}</version>
        </dependency>

        <!-- ========== 数据访问基线 ==========
             nexus-app 也直接编写 Mapper（sys_* / chat_*），因此显式声明 MyBatis-Plus。
             Boot 4 必须使用 mybatis-plus-spring-boot4-starter（3.x 系列仅供 Boot 3，禁用）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 分页插件（PaginationInnerInterceptor）自 3.5.9 起移到了 mybatis-plus-jsqlparser 模块 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- Spring AI：JDBC 版会话记忆仓库（表 SPRING_AI_CHAT_MEMORY）。
             注意它与本项目自建的 chat_message 是两件事：
             前者是"发给模型的有界窗口"，后者是"完整聊天历史"（ADR-011）。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <!-- 数据库驱动：MySQL 为业务真源，PostgreSQL 承载 pgvector 向量索引 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 数据库迁移。
             ⚠️ Boot 4 把自动配置拆成了独立模块：只引 flyway-core 时**没有自动配置**，
             表现为"应用照常启动、迁移从未执行"（本次真实踩坑：表一直没建出来）。
             必须引 spring-boot-starter-flyway（它带 flyway-core + Boot 自动配置模块）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- MySQL 与 PostgreSQL 各自的 Flyway 方言模块 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- 安全：JWT 资源服务器。
             注意 Boot 4 的坐标变化——旧的 spring-boot-starter-oauth2-resource-server 的 POM 描述已写明
             "deprecated in favor of spring-boot-starter-security-oauth2-resource-server"。
             该 starter 传递引入 spring-boot-starter-security 与 spring-security-oauth2-jose（含 Nimbus）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- 测试用内存库：让 MyBatis-Plus / Mapper 的兼容性验证不依赖 Docker。
             用 runtime（而非 test）作用域是为了让 standalone 开发 profile 也能启动：
             mvn spring-boot:run -Dspring-boot.run.profiles=standalone
             生产镜像会在打包阶段排除它（Phase 11）。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Boot 4 把 Web MVC 的测试支持拆成了独立模块（不再是 spring-boot-starter-test 的一部分），
             @AutoConfigureMockMvc 位于 org.springframework.boot.webmvc.test.autoconfigure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 安全测试支持：@WithMockUser 等（本步先引入，Step 1.1 的用例主要用真实 Token） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
