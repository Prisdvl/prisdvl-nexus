<?xml version="1.0" encoding="UTF-8"?>
<!--
  nexus-knowledge — 知识域核心库
  职责：文档解析、结构化切分、Embedding、向量/BM25 索引、混合检索、重排、引用、知识关联。
  约束（ADR-001）：不依赖 nexus-app；不引入 Spring Security；
  租户隔离一律通过方法参数显式传入 userId，禁止使用 SecurityContextHolder。

  依赖策略：本模块是「能力提供方」，因此把 AI 与数据访问依赖放在这里，
  使 nexus-app 与（Phase 7 的）nexus-mcp-server 能复用同一套检索实现。
  Step 0.2 只放最小依赖；AI/MyBatis/ES/向量库依赖在 Step 0.3 统一接入并验证。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lky.nexus</groupId>
        <artifactId>prisdvl-nexus</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>nexus-knowledge</artifactId>
    <name>nexus-knowledge</name>
    <description>知识域核心：解析 / 切分 / 嵌入 / 检索 / 引用 / 关联</description>

    <dependencies>
        <dependency>
            <groupId>com.lky.nexus</groupId>
            <artifactId>nexus-common</artifactId>
        </dependency>
        <!-- 知识域要用到模型配置：建库时要解析 embedding.default 角色并冻结维度（ADR-008），
             Phase 3 的嵌入与重排也在这里。依赖方向保持单向：common <- ai <- knowledge <- app -->
        <dependency>
            <groupId>com.lky.nexus</groupId>
            <artifactId>nexus-ai</artifactId>
        </dependency>

        <!-- Spring 容器与 Boot 基础设施（配置绑定、@Service 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 持久化：知识域自己要写 kb_* 的 Mapper，因此在此显式声明（版本由父 POM 管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>

        <!-- YAML 解析：用于 Markdown frontmatter。
             解析器刻意手写（而不是引入 CommonMark 等渲染库），
             因为我们要的不是 HTML，而是"忠实提取结构 + 字符偏移"：
             frontmatter / 标题层级 / WikiLink / 代码块边界 / 图片引用。
             渲染库会把 WikiLink 这类 Obsidian 语法当普通文本消化掉。 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- PDF 解析：PDFBox。
             注意 Boot 4 的 BOM 托管的可能是 3.x，而 3.x 把入口从 PDDocument.load 改成了
             Loader.loadPDF —— 这类破坏性变化必须先确认实际版本再写代码（本次已核实）。 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- DOCX 解析：Apache POI（ooxml 变体才支持 .docx）。
             DOCX 与 PDF 的关键差别：DOCX 里标题是有样式的（Heading1/2…），
             因此能抽出真正的标题层级，而不必靠字号猜。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
