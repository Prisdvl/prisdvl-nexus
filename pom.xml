<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prisdvl-Nexus — 聚合父 POM
  职责：统一版本、统一依赖管理、声明模块；不写任何业务代码。

  设计要点（见 docs/decisions.md ADR-001）：
  1) 以 spring-boot-starter-parent 为父：统一第三方依赖版本 + 插件默认配置。
  2) 额外 import spring-ai-bom 管理 Spring AI 全家桶版本（本项目不使用 1.x）。
  3) 内部模块版本集中在 dependencyManagement，子模块引用时不写版本号。
  4) spring-boot-maven-plugin 只在「可执行应用」模块声明（nexus-app / 未来的 nexus-mcp-server）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.lky.nexus</groupId>
    <artifactId>prisdvl-nexus</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>prisdvl-nexus</name>
    <description>Personal Knowledge Base &amp; Agent Platform — 个人知识库 + AI Agent 智能工作平台</description>

    <modules>
        <module>nexus-common</module>
        <module>nexus-ai</module>
        <module>nexus-knowledge</module>
        <module>nexus-app</module>
        <!-- Phase 7 加入：<module>nexus-mcp-server</module> -->
    </modules>

    <properties>
        <!-- 语言与编码 -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 保留方法参数名：Spring AI 的 @Tool/@ToolParam 与 MyBatis 参数绑定都依赖它 -->
        <maven.compiler.parameters>true</maven.compiler.parameters>

        <!-- 关键第三方版本（Boot 未托管的必须显式声明） -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>

        <!-- 测试 -->
        <skipUnitTests>false</skipUnitTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM：统一所有 spring-ai-* 版本（本项目基线 2.0.1，兼容 Boot 4.0.x/4.1.x） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.lky.nexus</groupId>
                <artifactId>nexus-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lky.nexus</groupId>
                <artifactId>nexus-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.lky.nexus</groupId>
                <artifactId>nexus-ai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis-Plus（Boot 4 专用 starter；不在 Boot BOM 中，必须钉版本） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 分页插件所在的模块。
                 自 3.5.9 起 MyBatis-Plus 把 JSqlParser 依赖拆成独立模块，
                 PaginationInnerInterceptor 也从 mybatis-plus-extension 移到了这里：
                 只加 starter 会导致「编译期找不到 PaginationInnerInterceptor」，
                 或者在别处静默降级成不分页。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- 显式声明注解处理器路径：避免 javac 的「类路径上存在注解处理器但未启用」警告，
                             同时保证 Lombok 在 Java 21 + Boot 4 下确定生效 -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- 刻意不在 POM 里硬编码 skipTests：一旦写了 <skipTests>false</skipTests>，
                             它会**覆盖**命令行的 -DskipTests，导致"想跳过测试却仍在跑全量测试"
                             （本机内存紧张时这会直接把构建搞崩）。留空即可让 Maven 内建的
                             -DskipTests / -Dmaven.test.skip 正常工作。 -->

                        <!-- 让「被 fork 出来的测试 JVM」用 UTF-8 输出到控制台。
                             Java 19 起决定 stdout 编码的是 stdout.encoding（不是 file.encoding），
                             中文 Windows 上默认是 GBK，会导致测试日志里的中文变成乱码。
                             同时给 fork 出来的 JVM 限定堆上限：本机 15.6GB 而 Docker VM 占 7.6GB，
                             默认堆（1/4 物理内存）会让多个 JVM 一起把内存吃光。 -->
                        <argLine>-Xmx512m -XX:MaxMetaspaceSize=256m -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -Dfile.encoding=UTF-8</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
