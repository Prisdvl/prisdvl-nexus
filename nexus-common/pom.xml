<?xml version="1.0" encoding="UTF-8"?>
<!--
  nexus-common — 共享内核
  职责：统一返回体、错误码、业务异常、分页模型、通用常量与工具。
  约束（ADR-001）：不依赖任何内部模块；不引入 Web / Security / AI 依赖，
  以便未来被 nexus-mcp-server 等任意进程复用。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lky.nexus</groupId>
        <artifactId>prisdvl-nexus</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>nexus-common</artifactId>
    <name>nexus-common</name>
    <description>共享内核：统一返回、错误码、异常、通用工具</description>

    <dependencies>
        <!-- 只依赖「语言/规范级」的库，保持内核轻量 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
