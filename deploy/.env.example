# ============================================================
# deploy/.env.example —— 基础设施端口与口令
#
# 用法：cp .env.example .env  （docker compose 会自动读取同目录下的 .env）
# 不创建 .env 也能跑，下面这些就是默认值。
#
# 端口之所以不是 3306/5432：本机已有原生 MySQL 8.0 与 PostgreSQL 18 在用默认端口，
# 改用 3307/5433 以免与你的其他项目互相干扰。
# ============================================================

# ---------- MySQL（业务真源）----------
NEXUS_MYSQL_PORT=3307
NEXUS_MYSQL_ROOT_PASSWORD=nexus_root_pwd
NEXUS_MYSQL_DATABASE=nexus
NEXUS_MYSQL_USER=nexus
NEXUS_MYSQL_PASSWORD=nexus_pwd

# ---------- PostgreSQL + pgvector（向量索引）----------
NEXUS_PG_PORT=5433
NEXUS_PG_DATABASE=nexus_vector
NEXUS_PG_USER=nexus
NEXUS_PG_PASSWORD=nexus_pwd

# ---------- Redis ----------
NEXUS_REDIS_PORT=6379

# ---------- Elasticsearch（版本需与 analysis-ik 一致）----------
NEXUS_ES_PORT=9200
NEXUS_ES_VERSION=9.4.5

# ---------- RabbitMQ ----------
NEXUS_RABBITMQ_PORT=5672
NEXUS_RABBITMQ_CONSOLE_PORT=15672
NEXUS_RABBITMQ_USER=nexus
NEXUS_RABBITMQ_PASSWORD=nexus_pwd

# ---------- Ollama（profile: ai-local）----------
NEXUS_OLLAMA_PORT=11434
