# ============================================================
# deploy/.env.example —— 端口、口令与密钥
#
# 用法：cp .env.example .env  （docker compose 会自动读取同目录下的 .env）
#
# 【哪些必须自己填】
#   JWT_SECRET、AI_CHAT_API_KEY、AI_EMBEDDING_API_KEY —— 这三个**没有默认值**，缺失时
#   `docker compose config` 直接报错退出（连容器都不会创建）。
#   这是刻意的：nexus.jwt.secret 的 fail-closed 语义不能被"示例文件里
#   带一个能跑的假密钥"绕过——否则"忘了配"的表现就是"启动成功、密钥是仓库里
#   人尽皆知的那个"。
#
# 【其余默认值是什么性质】
#   下面的 nexus_pwd / nexus_root_pwd 是**仅用于本机开发**的口令，
#   与 application-local.yml 里的默认值保持一致，目的是"clone 下来就能跑"。
#   生产环境必须全部替换（清单见 docs/deployment.md）。
#
# 【端口暴露面】
#   只有 NEXUS_FRONTEND_PORT 绑在 0.0.0.0（唯一入口）。
#   其余端口在 docker-compose.yml 里全部绑到 127.0.0.1——只给宿主机开发用，
#   不会被局域网/公网访问。
# ============================================================

# ---------- 入口 ----------
# 浏览器访问 http://localhost:8088
NEXUS_FRONTEND_PORT=8088

# ---------- 密钥（**必须填**，缺失则 compose 拒绝启动）----------
# 生成一个：
#   openssl rand -base64 48            （Git Bash / Linux / macOS）
#   [Convert]::ToBase64String((1..48 | ForEach-Object {Get-Random -Max 256)})   (PowerShell)
# 要求：UTF-8 下至少 32 字节（NexusJwtProperties.secretKey() 会拒绝更短的）。
JWT_SECRET=

# 模型网关的 API Key（对话/评测模型）。本机也可以只放 .secrets/ai-key.txt，
# 用 shell 注入：AI_CHAT_API_KEY=$(cat ../.secrets/ai-key.txt) docker compose up -d
AI_CHAT_API_KEY=

# 嵌入模型的 API Key（阿里云百炼 DashScope）。
# 整栈默认使用云端 text-embedding-v4（1024 维），不再需要本地 Ollama：
# 在 https://bailian.console.aliyun.com/ 创建 API-KEY 后填到这里。
AI_EMBEDDING_API_KEY=

# ---------- 模型网关（非敏感，可留默认）----------
# 换对话供应商只改这两行（OpenAI 兼容协议），例如 DeepSeek 官方：
#   AI_CHAT_BASE_URL=https://api.deepseek.com
#   AI_CHAT_MODEL=deepseek-chat
AI_CHAT_BASE_URL=https://opencode.ai/zen/go/v1
AI_CHAT_MODEL=deepseek-v4-flash
AI_JUDGE_MODEL=glm-5.3-flash

# ---------- MySQL（业务真源）----------
NEXUS_MYSQL_PORT=3307
NEXUS_MYSQL_ROOT_PASSWORD=nexus_root_pwd
NEXUS_MYSQL_DATABASE=nexus
NEXUS_MYSQL_USER=nexus
NEXUS_MYSQL_PASSWORD=nexus_pwd

# ---------- PostgreSQL + pgvector（向量索引）----------
NEXUS_PG_PORT=5433
NEXUS_PG_DATABASE=nexus_vector
NEXUS_PG_USER=nexus
NEXUS_PG_PASSWORD=nexus_pwd

# ---------- Redis ----------
NEXUS_REDIS_PORT=6379

# ---------- Elasticsearch（版本需与 analysis-ik 一致）----------
NEXUS_ES_PORT=9200
NEXUS_ES_VERSION=9.4.5

# ---------- RabbitMQ ----------
NEXUS_RABBITMQ_PORT=5672
NEXUS_RABBITMQ_CONSOLE_PORT=15672
NEXUS_RABBITMQ_USER=nexus
NEXUS_RABBITMQ_PASSWORD=nexus_pwd

# ---------- 嵌入模型（非敏感，可留默认）----------
# 云端：阿里云百炼 text-embedding-v4（compose 已无 Ollama 服务，无需本地拉模型）。
# 维度在知识库创建时冻结：改 AI_EMBEDDING_DIM 只影响新建的库，旧库必须重建。
AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIM=1024

# ---------- 邮件（验证码）----------
# 默认 console：验证码打到 backend 容器日志，不进真实邮箱。
# 使用 Resend 真邮时：
#   1) Windows「系统环境变量」或用户环境变量设置 RESEND_API_KEY（推荐，勿写入本文件）
#   2) 本文件设置：
#        NEXUS_EMAIL_SENDER=resend
#        NEXUS_EMAIL_RESEND_FROM=Prisdvl-Nexus <onboarding@resend.dev>
#   3) 改完环境变量后需新开终端（或重启 Cursor / Docker Desktop）再 docker compose up
#   4) 发件域名须在 Resend 控制台验证；测试可用 onboarding@resend.dev
NEXUS_EMAIL_SENDER=console
NEXUS_EMAIL_RESEND_FROM=
# RESEND_API_KEY=   # 不要写进仓库；用系统环境变量
