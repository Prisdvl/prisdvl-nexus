# ============================================================
# Prisdvl-Nexus — .gitignore
# 原则：密钥、构建产物、本地数据、IDE 配置一律不入库
# ============================================================

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ---------- IDE ----------
.idea/
*.iml
*.iws
*.ipr
*.hprof
.vscode/
*.code-workspace
.settings/
.project
.classpath

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 环境变量与密钥（绝不入库）----------
.env
.env.local
.env.*.local
.env.prod
# 注意：application-local.yml 是**提交进仓库**的 —— 它只包含 docker compose 的开发默认
# 账号口令（与 deploy/.env.example 一致），提交它是为了"clone 下来就能跑 local profile"。
# 真正的密钥文件（下面这些）仍然忽略。
application-secret.yml
application-secret.yaml
application-prod.yml
application-prod.yaml
*.pem
*.p12
*.jks

# ---------- 本地数据 / 上传文件 / 日志 ----------
/data/
/storage/
/uploads/
/logs/
/tmp/
*.log

# ---------- 助手工作区记忆（本机痕迹，不入库）----------
# .workbuddy/ 存的是会话记忆与临时状态：既不是源码也不是项目配置。
# 提交它只会让仓库多出一堆与项目无关的 diff，还会把本机路径带进去。
.workbuddy/

# ---------- 前端（Vue 3 + Vite）----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
coverage/

# ---------- Docker 绑定卷（如映射到仓库内）----------
deploy/volumes/
deploy/**/data/

# ---------- 测试与报告 ----------
**/target/
site/
*.exec

# ---------- 前端本地临时文件 ----------
# 截图/验证脚本会写入演示账号的 JWT 与知识库 id，绝不入库
web/.demo-token
web/.demo-kb-id
web/login-flow-failure.png

# ---- 构建日志 ----
build.log

# ---- 密钥文件（绝不入库）----
.secrets/
*.key.txt
