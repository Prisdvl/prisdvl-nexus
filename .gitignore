# ============================================================
# AI Knowledge Hub — .gitignore
# 原则：密钥、构建产物、本地数据、IDE 配置一律不入库
# ============================================================

# ---------- Java / Maven ----------
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ---------- IDE ----------
.idea/
*.iml
*.iws
*.ipr
*.hprof
.vscode/
*.code-workspace
.settings/
.project
.classpath

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 环境变量与密钥（绝不入库）----------
.env
.env.local
.env.*.local
.env.prod
application-local.yml
application-local.yaml
application-secret.yml
application-secret.yaml
application-prod.yml
application-prod.yaml
*.pem
*.p12
*.jks

# ---------- 本地数据 / 上传文件 / 日志 ----------
/data/
/storage/
/uploads/
/logs/
/tmp/
*.log

# ---------- 前端（Vue 3 + Vite）----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
coverage/

# ---------- Docker 绑定卷（如映射到仓库内）----------
deploy/volumes/
deploy/**/data/

# ---------- 测试与报告 ----------
**/target/
site/
*.exec

# ---- ������־ ----
build.log

# ---- ������Կ��������⣩----
.secrets/
*.key.txt
