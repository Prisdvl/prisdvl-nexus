{
  "$schema": "https://prisdvl.local/schemas/design-tokens.json",
  "meta": {
    "name": "Prisdvl Nexus",
    "version": "2026-10-14",
    "sourceOfTruth": "frontend/src/styles/tokens.css",
    "defaultTheme": { "mode": "dark", "palette": "prisdvl" },
    "principles": [
      "极简现代 + 沉浸式大背景；醒目但克制",
      "暗色：纯深黑/冷黑基座 + 强调色点缀（不要整页染色）",
      "品牌主题 Prisdvl = 独立深色深钴蓝，非 Accent 点缀",
      "Space Grotesk（拉丁/数字）+ 系统中文",
      "圆角分档 6/10/14/18；双层阴影；动效 130–280ms"
    ]
  },
  "font": {
    "display": "\"Space Grotesk\", \"PingFang SC\", \"Microsoft YaHei\", \"MiSans\", \"Segoe UI\", system-ui, sans-serif"
  },
  "motion": {
    "durFast": "130ms",
    "durUi": "200ms",
    "durPanel": "280ms",
    "easeOut": "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeInOut": "cubic-bezier(0.77, 0, 0.175, 1)"
  },
  "button": {
    "heightSm": "32px",
    "heightMd": "40px",
    "heightLg": "46px"
  },
  "sidebar": {
    "width": "236px",
    "widthCollapsed": "68px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "18px",
    "pill": "999px",
    "ctaLanding": "12px"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px"
  },
  "brand": {
    "prisdvl": {
      "primary": "#2457D6",
      "hover": "#3978F6",
      "active": "#193FA8",
      "ice": "#75C8FF",
      "highlight": "#C7EDFF",
      "deep": "#071747",
      "bg": "#080B12",
      "surface": "#101522",
      "surfaceMuted": "#171F31",
      "border": "#273349",
      "borderStrong": "#334663",
      "text": "#E8EEF8",
      "text2": "#A3B1C7",
      "text3": "#71809A",
      "input": "#0A0E16",
      "card": "#1B2435"
    }
  },
  "palettes": [
    { "id": "prisdvl", "label": "Prisdvl", "kind": "brand-forced-dark", "swatch": "#2457D6" },
    { "id": "ocean", "label": "棱镜蓝", "kind": "accent", "swatchLight": "#305478", "swatchDark": "#8aacc4" },
    { "id": "terracotta", "label": "陶土橘", "kind": "full", "swatchLight": "#b4542a", "swatchDark": "#e8a077" },
    { "id": "turquoise", "label": "松石青", "kind": "full", "swatchLight": "#1f7a8c", "swatchDark": "#6fd3de" },
    { "id": "lime", "label": "青柠", "kind": "full", "swatchLight": "#5f9c1a", "swatchDark": "#b9e26a" },
    { "id": "indigo", "label": "靛蓝", "kind": "accent", "swatchLight": "#4f46e5", "swatchDark": "#9b93ff" },
    { "id": "violet", "label": "紫罗兰", "kind": "accent", "swatchLight": "#c026a8", "swatchDark": "#f489e0" },
    { "id": "rose", "label": "玫红", "kind": "accent", "swatchLight": "#e11d48", "swatchDark": "#fb7185" }
  ],
  "semanticUi": {
    "hoverAlphaLight": "6%",
    "selectedAlphaLight": "10%",
    "hoverAlphaDark": "9%",
    "selectedAlphaDark": "14%"
  },
  "components": {
    "buttonVariants": ["primary", "ghost", "danger"],
    "buttonSizes": ["sm", "md", "lg"],
    "interactiveHoverButton": "frontend/src/registry/magicui/interactive-hover-button",
    "themeControl": "frontend/src/components/Appearance.tsx"
  }
}
