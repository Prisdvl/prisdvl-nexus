<?xml version="1.0" encoding="UTF-8"?>
<!--
  nexus-ai — AI 基础设施模块（模型可替换层的落地，见 ADR-003）

  职责：
    - 绑定 ai.providers / ai.roles 配置，按 provider 类型手工构建 ChatModel / EmbeddingModel
    - 以「逻辑角色」为业务侧唯一入口（chat.default / chat.agent / chat.judge / embedding.default）
    - 后续承载：Embedding 注册、Reranker（ADR-007）、Token/成本核算、评测裁判模型

  为什么单独成模块（ADR-001 修订）：
    nexus-app（chat / agent）与 nexus-knowledge（embedding / rerank）都要用模型，
    放在任一业务模块里都会造成另一侧反向依赖。独立成模块后依赖方向是单向的：
    common <- ai <- knowledge <- app。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lky.nexus</groupId>
        <artifactId>prisdvl-nexus</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>nexus-ai</artifactId>
    <name>nexus-ai</name>
    <description>AI 基础设施：多 provider 模型注册表、逻辑角色、ChatClient 工厂</description>

    <dependencies>
        <dependency>
            <groupId>com.lky.nexus</groupId>
            <artifactId>nexus-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- OpenAI 兼容协议：DeepSeek / Qwen(DashScope 兼容模式) / 智谱 / SiliconFlow / vLLM 都走这条 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 本地 Ollama：嵌入模型（bge-m3）与离线对话模型 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
