# ============================================================
# AI Knowledge Hub — 环境变量示例
# 用法：cp .env.example .env  然后填入真实值
# .env 已被 .gitignore 忽略，禁止把真实密钥提交到仓库
# ============================================================

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- MySQL（业务真源）----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=akh
MYSQL_USERNAME=akh
MYSQL_PASSWORD=akh_pwd_please_change
MYSQL_ROOT_PASSWORD=root_pwd_please_change

# ---------- PostgreSQL + pgvector（向量索引）----------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=akh_vector
PG_USERNAME=akh
PG_PASSWORD=akh_pwd_please_change

# ---------- Redis（缓存 / 限流 / 锁）----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- RabbitMQ（异步导入 / 评测 / 报告）----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=akh
RABBITMQ_PASSWORD=akh_pwd_please_change

# ---------- Elasticsearch（BM25 + IK 分词）----------
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ---------- 对话模型（云端 OpenAI-compatible）----------
# DeepSeek:    https://api.deepseek.com
# SiliconFlow: https://api.siliconflow.cn
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_API_KEY=
AI_CHAT_MODEL=deepseek-chat

# ---------- 评测裁判模型（可用更便宜的模型）----------
AI_JUDGE_BASE_URL=https://api.deepseek.com
AI_JUDGE_API_KEY=
AI_JUDGE_MODEL=deepseek-chat

# ---------- 嵌入模型（本地 Ollama bge-m3，1024 维）----------
AI_EMBEDDING_BASE_URL=http://localhost:11434
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_DIM=1024

# ---------- JWT ----------
# 生成方式（PowerShell）：[Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
JWT_SECRET=please_generate_a_random_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=7d

# ---------- MCP（Phase 7）----------
MCP_SERVER_PORT=8090
MCP_INTERNAL_API_KEY=
