# ============================================================
# Prisdvl-Nexus — 环境变量示例
# 用法：cp .env.example .env  然后填入真实值
# .env 已被 .gitignore 忽略，禁止把真实密钥提交到仓库
# ============================================================

# ---------- 应用 ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ---------- MySQL（业务真源）----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=nexus
MYSQL_USERNAME=nexus
MYSQL_PASSWORD=nexus_pwd_please_change
MYSQL_ROOT_PASSWORD=root_pwd_please_change

# ---------- PostgreSQL + pgvector（向量索引）----------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nexus_vector
PG_USERNAME=nexus
PG_PASSWORD=nexus_pwd_please_change

# ---------- Redis（令牌版本 / 登录失败计数 / 限流 / 每日配额）----------
# Phase 5.6 起 Redis 有真实用途；此前它只是 compose 里的一个服务定义，这些变量没有任何代码读。
# 开关是 NEXUS_SECURITY_REDIS_ENABLED（见下），关掉时走进程内存实现，**下面三个变量完全不会被读取**。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 安全（Phase 5.6）----------
# 限流/配额/令牌版本用 Redis 还是进程内存。
#   false（默认）→ 内存实现：单实例有效，多实例各算一份（限流被放大 N 倍）
#   true         → Redis：多实例共享，但每次鉴权多一次 GET
# ⚠️ 生产（多实例）必须 true。local profile 已在 yaml 里默认开 true。
NEXUS_SECURITY_REDIS_ENABLED=false
# 令牌版本缓存的 TTL。它同时是"缓存失效时旧令牌还能活多久"的上限：
# invalidate 抛异常的话缓存里那条旧版本会继续被读到，直到过期（DB 已是新值）。
JWT_TOKEN_VERSION_CACHE_TTL=5m
# 登录失败限制：同一用户名在窗口内失败 N 次 → 冻结。两个都取 15 分钟，恢复时间可接受。
NEXUS_LOGIN_MAX_FAILURES=5
NEXUS_LOGIN_FAILURE_WINDOW=15m
NEXUS_LOGIN_LOCK_DURATION=15m
# 用户级每分钟请求上限（只作用于模型入口 + 改密码，不是全部接口）
NEXUS_RATE_LIMIT_PER_MINUTE=20
# 注册入口每 IP 每小时上限。⚠️ 反向代理后 getRemoteAddr() 是代理地址，
# 本期不信任 X-Forwarded-For（见 docs/decisions.md ADR-020）
# ⚠️ 开发 profile（standalone / local / test）默认值是 1000，不是这里的 10：
#    本机请求全来自同一个回环地址，E2E 脚本每轮都会自己注册临时账号，
#    实测到第 9 次就 429，而症状会跑到"紧接着的登录 401"上（看起来像认证坏了）。
#    生产环境不放宽。要在开发 profile 上验真实阈值，就显式设这个变量为 10。
NEXUS_REGISTER_PER_HOUR=10

# ---------- RabbitMQ（异步导入 / 评测 / 报告）----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=nexus
RABBITMQ_PASSWORD=nexus_pwd_please_change

# ---------- Elasticsearch（BM25 + IK 分词）----------
ES_URIS=http://localhost:9200
ES_USERNAME=
ES_PASSWORD=

# ---------- 对话模型（OpenAI 兼容网关）----------
# 当前使用 OpenCode Zen：https://opencode.ai/zen/go/v1
#   可用模型（走 /chat/completions 协议的）：deepseek-v4-flash / deepseek-v4.1-flash /
#   deepseek-v4-pro / glm-5.3-flash / glm-5.3 / kimi-k2.6 / kimi-k3 / longcat-2.0 /
#   mimo-v2.6-flash / hy3 / space-bunny-free
#   ⚠️ Qwen3.8 / MiniMax 走的是 /messages（Anthropic 协议），Grok / GPT-Luna 走 /responses，
#      不能直接用本项目的 OpenAI 兼容接入，需要换协议模块。
# 也可换成任何 OpenAI 兼容端点：
#   DeepSeek 官方 https://api.deepseek.com（模型 deepseek-chat）
#   SiliconFlow   https://api.siliconflow.cn/v1
#   阿里云百炼     https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_BASE_URL=https://opencode.ai/zen/go/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=deepseek-v4-flash

# 该网关要求客户端标识自己，并为每个会话发送稳定的 session id（用于路由与 prompt 缓存）
AI_CHAT_USER_AGENT=nexus-knowledge-hub/0.1
AI_CHAT_SESSION_ID=nexus-local-session

# ---------- 评测裁判模型（用另一家的模型，降低"自己评自己"的偏好偏差）----------
AI_JUDGE_MODEL=glm-5.3-flash

# ---------- 嵌入模型（本地 Ollama bge-m3，1024 维）----------
AI_EMBEDDING_BASE_URL=http://localhost:11434
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_DIM=1024

# ---------- JWT ----------
# 生成方式（PowerShell）：[Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
JWT_SECRET=please_generate_a_random_secret_of_at_least_32_bytes
JWT_ACCESS_TOKEN_TTL=30m
# ⚠️ 这个变量目前是**死的**：refresh token 没有实现（代码里没有任何路径读它，
# `sys_refresh_token` 表也不存在）。留着是为了让"计划里有、代码里没有"这件事
# 至少在迁移时被看见——见 docs/decisions.md ADR-021 第 ⑤ 阶段。
JWT_REFRESH_TOKEN_TTL=7d

# ---------- MCP（Phase 7）----------
# 独立 MCP Server 进程的端口（目标态，尚未落地；当前可用的是进程内的 POST /mcp，
# 它的身份与全站一致：Authorization: Bearer <JWT>）。
MCP_SERVER_PORT=8090
# 这里曾经有一个 MCP_INTERNAL_API_KEY——它**从未被任何代码读过**，已删除。
# 留着它比没有更糟：它让人以为 /mcp 受 API Key 保护，而实际上那条路径当时免认证、
# 身份由 `X-Nexus-User` 请求头自证（可读任意用户知识库）。见 docs/decisions.md B.42。
